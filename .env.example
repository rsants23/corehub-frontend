# CoreHub Frontend — variáveis de ambiente
# Copie para .env.local (dev) ou .env (produção)

# URL base da API (inclui /api)
NEXT_PUBLIC_API_URL=http://localhost:3100/api

# Porta do Next.js em produção (PM2)
PORT=3000

# Host bind — use 0.0.0.0 no WSL para acesso a partir do Windows
# Configurado em package.json: next start -H 0.0.0.0
